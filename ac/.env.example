# ============ AgentCarbon configuration ============
# The ONLY value you must add for the AI agents:
GROQ_API_KEY=

# Groq-hosted OpenAI GPT-OSS 120B
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high  (higher = deeper reasoning, slower, more tokens)
GROQ_REASONING_EFFORT=low
# Pause between Groq calls (seconds). Raise it if you hit rate limits on a free tier.
GROQ_CALL_DELAY_SECONDS=2
# Debate rounds after the first assessment. 0 = fewer tokens/faster, 1 = full debate.
AGENT_DEBATE_ROUNDS=1

# ---- Optional ----
# Leave empty to use the built-in SQLite file (data/agentcarbon.db).
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/agentcarbon
DATABASE_URL=

# Leave empty: a random secret is generated once and stored in data/jwt_secret.key
JWT_SECRET_KEY=

# Demo mode creates ready-made demo accounts (shared password below).
# Set DEMO_MODE=false for a real deployment, then use backend/scripts/create_user.py
DEMO_MODE=true
DEMO_PASSWORD=Demo@12345

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
